": 215.69547806670036, "c": 1, "w": 1888.5338134765623, "h": 67.27325439453111, "y": 2306.9999997816076}, {"y": 2368.9999990874962, "w": 508.08270263671875, "c": 1, "t": "further punitive action.", "h": 62.99999999999986, "x": 220.48871775823852}, {"x": 1030.356505437276, "t": "PART -II", "c": 1, "y": 2478.778112535232, "w": 254.41856384277344, "h": 50.00191497802741}, {"c": 1, "x": 1902.9135302231225, "y": 2484.593022951149, "t": "70 marks", "w": 220.48872375488284, "h": 52.761627197265746}, {"t": "Question paper comprises 6 questions. Answer Question No. 1 which is compulsory", "c": 1, "h": 72.9458923339846, "w": 1850.7486572265627, "y": 2547.2622298290753, "x": 248.96291690761495}, {"h": 67.45348739624032, "x": 249.24813912895024, "w": 920.3007202148436, "y": 2608.999999338038, "t": "and any 4 out of the remaining 5 questions.", "c": 1}, {"c": 1, "t": "Working notes should form part of the answer.", "y": 2686.0000003504692, "x": 249.2481531709643, "w": 1025.7518310546875, "h": 62.4011611938474}, {"w": 62.31203079223634, "c": 1, "h": 52.761627197265746, "x": 134.2105264765322, "y": 2686.046511782908, "t": "2."}, {"w": 1854.981201171875, "c": 1, "y": 2762.790698233018, "t": "Answers to the questions are to be given only in English except in the case of", "x": 249.24813667675016, "h": 67.20930099487305}, {"w": 1855.7698974609375, "t": "candidates who have opted for Hindi Medium. If a candidate has not opted for Hindi", "c": 1, "x": 244.03396145804936, "h": 80.71804046630842, "y": 2819.0791107327677}, {"t": "Medium, his/her answers in Hindi will not be evaluated.", "x": 244.45493074259844, "y": 2882.7034906379054, "c": 1, "w": 1231.8608398437498, "h": 72.29650878906278}, {"t": "CFT2 (H)", "x": 992.0649922071607, "y": 2992.448418650635, "w": 244.72340393066406, "h": 58.70781326293933, "c": 1}, {"t": "P.T.O.", "x": 1917.2932396841995, "y": 2993.0232566123786, "w": 172.55638122558636, "c": 1, "h": 67.15116119384784}, {"x": 301.973721802088, "h": 34.00000000000022, "t": 