# PassBook, hosted copy: written by build.py --site (HOSTING.md). Every app file is asked for as <path>?v=<content hash>, so app/, data/ and
# vendor/ may be cached for a year; the page, the service worker and the web manifest are always revalidated, so a new version is seen at once.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json
/app/*
  Cache-Control: public, max-age=31536000, immutable
/data/*
  Cache-Control: public, max-age=31536000, immutable
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
